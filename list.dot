digraph List {
    rankdir = BT;

    p [shape = diamond, label = p, group = "first"]

    node [shape=box];

    subgraph cells {
        rank=same;

        c1 [group = "first", shape=plaintext, margin=0, label = <
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
                <TR>
                    <TD> "Alabama" </TD>
                    <TD PORT="link">Link</TD>
                </TR>
            </TABLE>
        >]
        c2 [label = "…"]
        c3 [label = "\"Wyoming\""]

        c1 -> c2 [tailclip = false, tailport = link];
        c2 -> c3;
    }

    p -> c1 [headport = sw];
    p -> c3;
}
