digraph List {
    rankdir = BT;

    p [shape = diamond, label = p]

    subgraph cells {
        rank=same;

        c1 [shape=plain, margin=0, label = <
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
                <TR>
                    <TD PORT="elem">"Alabama"</TD>
                    <TD>    </TD>
                </TR>
            </TABLE>
        >]

        c2 [shape=ellipse, style = dotted, label = "…"]

        c3 [shape=plain, margin=0, label = <
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
                <TR>
                    <TD>"Wyoming"</TD>
                    <TD>NULL</TD>
                </TR>
            </TABLE>
        >]

        c1 -> c2;
        c2 -> c3;
    }

    p -> c1:elem:sw;
    // p -> c3;
}
